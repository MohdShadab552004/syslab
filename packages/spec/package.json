{
  "name": "@syslab/spec",
  "version": "0.1.0",
  "private": true,
  "description": "LLM-friendly SysLab design format: schema, validation, auto-layout and conversion to/from the editor document.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@syslab/sim": "workspace:*",
    "@syslab/types": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
